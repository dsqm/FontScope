<Window x:Class="FontScope.StatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="查询结果统计" Width="600" Height="660" MinWidth="480" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
        Background="White">
    <DockPanel>
        <!-- 底部按钮 -->
        <Border DockPanel.Dock="Bottom" Padding="14,10" Background="#FAFAFA"
                BorderBrush="#DDD" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="复制统计摘要" Padding="14,5" Click="Copy_Click" />
                <Button Content="关闭" Padding="14,5" Margin="10,0,0,0"
                        Click="Close_Click" IsCancel="True" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18,14">

                <!-- 标题 + 查询字符 -->
                <DockPanel Margin="0,0,0,12">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding QueryTextDisplay}"
                               Foreground="#888" FontSize="12" VerticalAlignment="Bottom"
                               MaxWidth="260" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="查询结果统计" FontSize="15" FontWeight="Bold" />
                </DockPanel>

                <!-- 命中总数 + 来源分布 -->
                <Border Background="#F7F7F7" BorderBrush="#E5E5E5" BorderThickness="1"
                        Padding="14,12" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="命中" Foreground="#888" FontSize="12" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding TotalFaces, StringFormat={}{0:N0}}"
                                       FontSize="24" FontWeight="Bold" />
                            <TextBlock Text=" 个 face" FontSize="14" VerticalAlignment="Bottom"
                                       Margin="0,0,0,2" />
                            <TextBlock Text="{Binding TotalFilesText}" FontSize="13" Foreground="#888"
                                       VerticalAlignment="Bottom" Margin="4,0,0,3" />
                        </StackPanel>

                        <!-- 分布条：列宽由代码按占比动态分配 -->
                        <Grid x:Name="BarGrid" Height="8" Margin="0,12,0,8" />

                        <!-- 图例 -->
                        <ItemsControl ItemsSource="{Binding Sources}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                        <Rectangle Width="8" Height="8" Fill="{Binding BarBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <TextBlock FontSize="12" Foreground="#666">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} {1:N0}（{2}）">
                                                    <Binding Path="Name" />
                                                    <Binding Path="FaceCount" />
                                                    <Binding Path="PercentText" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 格式分布 + 占坑 -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="格式分布" Foreground="#888" FontSize="12" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Formats}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding Count, StringFormat={}{0:N0}}"
                                                   Foreground="#666" FontSize="12" />
                                        <TextBlock Text="{Binding Name}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="占坑字体" Foreground="#888" FontSize="12" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding BlankCount, StringFormat={}{0:N0}}"
                                   FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="占坑 = 有码位但字形为空；彩色字体与解析失败者不计入，可能漏计，以预览为准。"
                                   FontSize="11" Foreground="#999" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>

                <!-- 来源分组 → 目录列表 -->
                <ItemsControl ItemsSource="{Binding Sources}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                    <Rectangle Width="8" Height="8" Fill="{Binding BarBrush}"
                                               VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" />
                                    <TextBlock Text="{Binding FaceCount, StringFormat={}{0:N0}}"
                                               Foreground="#888" FontSize="12" Margin="6,0,0,0" />
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding Folders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- 整行可双击；路径过长截断，悬停看完整 -->
                                            <Border Padding="8,4" Cursor="Hand" ToolTip="{Binding Dir}"
                                                    MouseLeftButtonDown="FolderRow_DoubleClick">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#F2F2F2" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                                Margin="12,0,0,0">
                                                        <TextBlock Text="{Binding FaceCount, StringFormat={}{0:N0}}"
                                                                   FontSize="12" Foreground="#666" />
                                                        <TextBlock Text="{Binding CountNote}"
                                                                   FontSize="12" Foreground="#999" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Dir}" FontSize="12"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="双击目录行可在资源管理器中打开" FontSize="11" Foreground="#999"
                           Margin="0,4,0,0" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
